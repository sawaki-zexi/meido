+/// Source-bound capture evidence. WGC lacks a proven screen origin here.
+pub fn screenshot_window_evidence(hwnd: u64) -> Result<(Vec<u8>, serde_json::Value)> {
+    let (png, occluded, geometry) = screenshot_window_mapped(hwnd)?;
+    if occluded { bail!("Meido refuses occluding-window pixels"); }
+    let (w, h) = png_dimensions_pub(&png)?;
+    let evidence = serde_json::json!({
+        "provenance": if geometry.is_some() { "print_window" } else { "wgc" },
+        "source_window_id": hwnd,
+        "source_dimensions": [w, h], "image_dimensions": [w, h],
+        "physical_origin": geometry.map(|g| [g.left, g.top]),
+        "resize_ratio": geometry.map(|_| 1.0),
+        "pixel_coordinates_available": geometry.is_some()
+    });
+    Ok((png, evidence))
+}
