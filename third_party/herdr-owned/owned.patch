diff --git a/src/meido_owned.rs b/src/meido_owned.rs
new file mode 100644
index 00000000..7b8a8b97
--- /dev/null
+++ b/src/meido_owned.rs
@@ -0,0 +1,133 @@
+//! Meido owned-mode additions to Herdr 0.9.4 (Apache-2.0).
+//! Local IPC and process ownership are not a same-account security sandbox.
+use std::io::{self, BufRead, Read, Write};
+use std::path::Path;
+
+pub(crate) const PROTOCOL: u32 = 1;
+
+pub(crate) fn enabled() -> bool {
+    std::env::var("MEIDO_HERDR_OWNED").as_deref() == Ok("1")
+}
+
+pub(crate) fn capabilities() -> serde_json::Value {
+    serde_json::json!({
+        "protocol": PROTOCOL,
+        "version": "0.9.4-meido.1",
+        "upstreamCommit": "7e26bad94044eba205033111a0ce8033ede7e24f",
+        "features": ["explicit-session", "foreground-only", "no-registry-env", "no-shell-profile", "fixed-agent-template", "no-restore-update-plugin", "bounded-session-hook", "host-owned-job"],
+        "generation": std::env::var("MEIDO_HERDR_GENERATION").unwrap_or_default(),
+        "pid": std::process::id()
+    })
+}
+
+pub(crate) fn entry(args: &[String]) -> io::Result<bool> {
+    if args.get(1).map(String::as_str) == Some("--meido-owned-capabilities") {
+        println!("{}", capabilities());
+        return Ok(true);
+    }
+    if !enabled() {
+        return Err(io::Error::other(
+            "Meido build requires explicit owned-mode environment",
+        ));
+    }
+    let session = std::env::var("MEIDO_HERDR_SESSION").unwrap_or_default();
+    if !session.starts_with("meido-")
+        || session.len() > 64
+        || !session
+            .bytes()
+            .all(|c| c.is_ascii_alphanumeric() || c == b'-')
+    {
+        return Err(io::Error::other("invalid owned session"));
+    }
+    let root = std::env::var("MEIDO_HERDR_ROOT").unwrap_or_default();
+    if !Path::new(&root).is_absolute() || !Path::new(&root).is_dir() {
+        return Err(io::Error::other("owned data root is required"));
+    }
+    for key in [
+        "XDG_CONFIG_HOME",
+        "XDG_STATE_HOME",
+        "HOME",
+        "USERPROFILE",
+        "APPDATA",
+        "LOCALAPPDATA",
+        "HERDR_CONFIG_PATH",
+    ] {
+        let path = std::env::var(key).unwrap_or_default();
+        if !Path::new(&path).is_absolute() || !Path::new(&path).starts_with(&root) {
+            return Err(io::Error::other("owned configuration roots are required"));
+        }
+    }
+    let explicit = args
+        .windows(2)
+        .any(|w| w[0] == "--session" && w[1] == session);
+    if !explicit {
+        return Err(io::Error::other("explicit owned session is required"));
+    }
+    let command = args.iter().skip(1).enumerate().find_map(|(i, a)| {
+        if a == "--session" || args.get(i).map(String::as_str) == Some("--session") {
+            None
+        } else {
+            Some(a.as_str())
+        }
+    });
+    if !matches!(
+        command,
+        Some("server" | "status" | "worktree" | "agent" | "pane" | "integration" | "owned-status")
+    ) {
+        return Err(io::Error::other(
+            "owned build disallows TUI, daemon, remote, update and plugin commands",
+        ));
+    }
+    if args
+        .iter()
+        .any(|a| matches!(a.as_str(), "--handoff-import" | "--remote" | "--handoff"))
+    {
+        return Err(io::Error::other(
+            "owned build disallows detached and remote handoff",
+        ));
+    }
+    Ok(false)
+}
+
+pub(crate) fn agent_executable(kind: &str, args: &[String]) -> Option<String> {
+    let expected_kind = std::env::var("MEIDO_HERDR_AGENT_KIND").ok()?;
+    let expected: Vec<String> =
+        serde_json::from_str(&std::env::var("MEIDO_HERDR_AGENT_ARGS").ok()?).ok()?;
+    let exe = std::env::var("MEIDO_HERDR_AGENT_EXE").ok()?;
+    (kind == expected_kind
+        && args == expected
+        && Path::new(&exe).is_absolute()
+        && Path::new(&exe).is_file())
+    .then_some(exe)
+}
+
+pub(crate) fn server_status_line(line: &str) -> Option<serde_json::Value> {
+    let request: serde_json::Value = serde_json::from_str(line).ok()?;
+    if !enabled() || request.get("method")?.as_str()? != "meido.owned.status" {
+        return None;
+    }
+    let id = request.get("id")?.as_str()?;
+    if request.get("params")? != &serde_json::json!({})
+        || request.as_object()?.len() != 3
+        || id.len() > 100
+    {
+        return None;
+    }
+    Some(serde_json::json!({"id": id, "result": capabilities()}))
+}
+
+pub(crate) fn print_server_status() -> io::Result<()> {
+    let mut stream = crate::ipc::connect_local_stream(&crate::api::socket_path())?;
+    stream.write_all(
+        b"{\"id\":\"meido:owned-status\",\"method\":\"meido.owned.status\",\"params\":{}}\n",
+    )?;
+    let mut line = String::new();
+    let mut reader = io::BufReader::new(stream).take(65537);
+    reader.read_line(&mut line)?;
+    if line.len() > 65536 {
+        return Err(io::Error::other("owned status exceeds budget"));
+    }
+    let _: serde_json::Value = serde_json::from_str(&line).map_err(io::Error::other)?;
+    print!("{line}");
+    Ok(())
+}
